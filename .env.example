# Where tools read and write files. Tools cannot touch anything outside this folder.
MUSE_WORKSPACE=./workspace

# Image generation: "mock" (default, no key needed), "openai" or "replicate"
MUSE_IMAGE_PROVIDER=mock   # or "auto" to use real providers when keys exist
OPENAI_API_KEY=
# openai: gpt-image-1 (default). replicate: owner/name of the image model
MUSE_IMAGE_MODEL=gpt-image-1

# Video generation: "mock" (default, makes a test clip with ffmpeg) or "replicate"
MUSE_VIDEO_PROVIDER=mock   # or "auto"
REPLICATE_API_TOKEN=
# Replicate model in owner/name form, e.g. the video model you want to use
MUSE_VIDEO_MODEL=

# Font file for text overlays on video (auto-detected on most systems)
# MUSE_FONT=/path/to/font.ttf

# Video models accept only certain lengths; requested seconds snap to the nearest
# MUSE_VIDEO_DURATIONS=4,6,8
# Extra model-specific options as JSON
# MUSE_VIDEO_EXTRA_INPUT={"resolution":"720p"}
# MUSE_IMAGE_EXTRA_INPUT={}
